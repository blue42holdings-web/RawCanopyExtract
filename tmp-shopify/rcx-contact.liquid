{% render 'rcx-home-css' %}
<div class="rcx">
<div class="rcx-field" aria-hidden="true"></div>
<div class="rcx-in">
<nav class="rcx-nav" aria-label="Main"><div class="rcx-nav-in"><a class="brand" href="{{ routes.root_url }}">RAW CANOPY EXTRACT</a><ul>{%- for link in linklists['main-menu'].links -%}<li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | upcase }}</a></li>{%- endfor -%}</ul></div></nav>
<section class="rcx-box rcx-page">
<p class="rcx-kick">CONTACT</p>
<h2 class="dsh" data-sweep><span>GET IN TOUCH</span></h2>
<p>Questions about the line, or anything else? Write to us and we'll get back to&nbsp;you.</p>
{% form 'contact', id: 'rcx-contact' %}
{% if form.posted_successfully? %}<p class="rcx-ok">Thank you. Your message is on its way to&nbsp;us.</p>{% else %}
{% if form.errors %}<p class="rcx-err">Please check your email address and message, then try&nbsp;again.</p>{% endif %}
<div class="rcx-cf">
<input type="text" name="contact[name]" placeholder="Name" aria-label="Name" autocomplete="name" value="{{ form.name }}">
<input type="email" name="contact[email]" placeholder="Email address" aria-label="Email address" autocomplete="email" required value="{{ form.email }}">
<textarea name="contact[body]" placeholder="Your message" aria-label="Your message" rows="6" required>{{ form.body }}</textarea>
<button type="submit">SEND</button>
</div>{% endif %}
{% endform %}
</section>
<p class="rcx-fine">These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any&nbsp;disease.</p>
<nav class="rcx-legal" aria-label="Legal"><a href="{{ shop.privacy_policy.url }}">PRIVACY POLICY</a><a href="{{ shop.terms_of_service.url }}">TERMS OF SERVICE</a></nav>
<div class="rcx-foot"><img src="{{ 'rcx-vine.svg' | asset_url }}" alt="" loading="lazy"></div>
</div>
</div>
{% render 'rcx-home-js' %}
{% render 'rcx-rail' %}
{% schema %}
{"name":"RCX Contact","settings":[],"presets":[{"name":"RCX Contact"}]}
{% endschema %}