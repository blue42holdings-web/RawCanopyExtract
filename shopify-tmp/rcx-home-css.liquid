.rcx-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:26px 0 6px}
.rcx-p{text-align:center}.rcx-p .ph{aspect-ratio:1/1;display:flex;align-items:center}.rcx-p .in{position:relative;width:100%}.rcx-p img{width:100%;height:auto;display:block}.rcx-blur{position:absolute;border-radius:6px;-webkit-backdrop-filter:blur(3.5px);backdrop-filter:blur(3.5px)}
.rcx-p h3{font-family:'Bebas Neue',sans-serif;font-weight:400;letter-spacing:.08em;font-size:22px;color:var(--cream);margin:8px 0 2px}
.rcx-soon{display:block;margin-top:20px;font-family:'Bebas Neue',sans-serif;letter-spacing:.22em;font-size:18px;color:var(--gold)}
.rcx-form{display:flex;max-width:460px;margin:22px auto 0;border:2px solid var(--gold);border-radius:999px;overflow:hidden}
.rcx-form input{flex:1;min-width:0;background:transparent;border:0;color:var(--cream);font:inherit;font-size:17px;padding:14px 18px;outline:none}
