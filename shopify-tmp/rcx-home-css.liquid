.rcx-qrw{width:128px;height:128px;padding:9px;background:#fff;border:2px solid var(--gold);border-radius:10px;margin:16px auto 2px}.rcx-qrw .qr{display:block;width:100%;height:100%}
.rcx-cell .tag{margin-top:auto;padding-top:14px;font-style:italic;color:var(--gold)}
.rcx-band{text-align:center;padding:34px 0 40px}
