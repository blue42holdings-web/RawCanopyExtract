@media (max-width:760px){.rcx-three{grid-template-columns:1fr;grid-auto-rows:auto}.rcx-cell .tag{margin-top:0}.rcx-grid{grid-template-columns:repeat(2,1fr)}.rcx-box{padding:30px 18px}}

