.rcx-m .pp{font-family:'Bebas Neue',sans-serif;letter-spacing:.12em;font-size:15px;line-height:1.5;color:var(--cream);margin:0 0 16px}.rcx-m .pp b{font-weight:400;color:var(--gold);margin-right:6px}
.rcx-m .kick2{font-family:'Bebas Neue',sans-serif;letter-spacing:.2em;font-size:15px;color:var(--gold);margin:0 0 8px}
