@keyframes rcxStrip{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (min-width:1000px){.rcx-strip{margin:6px 0 26px;border:2px solid var(--gold);border-radius:14px}.rcx-track{width:100%}.rcx-set{width:100%;justify-content:space-between;padding:0 10px}.rcx-dup{display:none}.rcx-strip .rcx-b{width:auto;flex:1 1 0;padding:0 2px}}
@media (max-width:999px){.rcx-track{animation:rcxStrip 40s linear infinite}}
@media (prefers-reduced-motion:reduce){.rcx-track{animation:none !important}}
.rcx-p p{margin:0 !important;max-width:none !important}.rcx-p .ct{font-family:'Bebas Neue',sans-serif;font-size:16px !important;letter-spacing:.12em;line-height:1.25 !important;color:var(--gold) !important}.rcx-p .ct span{display:block;white-space:nowrap}.rcx-p{display:flex;flex-direction:column}.rcx-p .pr{margin-top:auto !important;padding-top:6px}.rcx-p .pr{font-size:18px !important;color:var(--cream) !important}.rcx-nav{max-width:760px;margin:0 auto;padding:30px 0 0;display:flex;align-items:center}.rcx-nav-in{flex:1;display:flex;align-items:center;justify-content:space-between;gap:10px 22px;flex-wrap:wrap}.rcx-nav a{font-family:'Bebas Neue',sans-serif;font-weight:400;text-decoration:none;line-height:1}.rcx-nav .brand{font-size:19px;letter-spacing:.16em;color:var(--gold);white-space:nowrap}.rcx-nav ul{list-style:none;margin:0;padding:0;display:flex;gap:24px}.rcx-nav ul a{font-size:19px;letter-spacing:.16em;color:var(--cream)}.rcx-nav ul a:hover,.rcx-nav ul a[aria-current]{color:var(--gold)}@media (max-width:640px){.rcx-nav-in{flex-direction:column;justify-content:center;gap:12px}.rcx-nav ul{gap:20px}}.rcx-sub{font-family:'Bebas Neue',sans-serif;letter-spacing:.22em;font-size:clamp(16px,3.4vw,24px);color:var(--cream);margin:14px 0 0}.rcx-tpw{display:grid;width:fit-content;grid-template-columns:auto 1fr auto 1fr auto;column-gap:.52em;row-gap:26px;align-items:end;justify-items:center;margin:0 auto 28px;font-family:'Bebas Neue',sans-serif;font-size:clamp(34px,8vw,64px);letter-spacing:.12em;line-height:1;color:var(--gold);white-space:nowrap}.rcx-tpw .w{position:relative;padding-left:.12em;grid-row:1}.rcx-tpw .dt{position:absolute;left:100%;top:0}.rcx-tpw .ds{grid-row:1;align-self:center;width:clamp(18px,4vw,36px);height:3px;background:var(--gold);margin-bottom:.12em}.rcx-tpw .dk{grid-row:2;height:clamp(40px,9vw,58px);width:auto;display:block}.rcx-tpw .dk:nth-of-type(1){grid-column:2}.rcx-tpw .dk:nth-of-type(2){grid-column:3}.rcx-tpw .dk:nth-of-type(3){grid-column:4}.rcx-tpw .dk-sm{height:clamp(48px,10.8vw,70px)}
@keyframes rcxSealRing{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
</style>