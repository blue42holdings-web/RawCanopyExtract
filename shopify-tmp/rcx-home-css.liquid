.rcx-box .rcx-tiles p.rcx-tri{margin:0 !important;padding:22px 10px;border:2px solid var(--gold);border-radius:14px;color:#111;font-size:16px;line-height:1.6;display:flex;flex-direction:column;justify-content:center}
.t-lm{background:#D3E6F7}.t-cd{background:#D9F0D6}.t-tt{background:#E3D9F4}
.m-lions-mane{background:#D3E6F7 !important}.m-cordyceps{background:#D9F0D6 !important}.m-turkey-tail{background:#E3D9F4 !important}
.rcx-m h3{color:#111 !important}.m-lions-mane h3,.m-lions-mane .kick2{color:#1B3F6B !important}.m-cordyceps h3,.m-cordyceps .kick2{color:#1F6B36 !important}.m-turkey-tail h3,.m-turkey-tail .kick2{color:#4B2A8A !important}
.rcx-m .lat{color:#222 !important}.rcx-m .pp{color:#111 !important}.rcx-m .pp b{color:inherit !important;opacity:.6}.rcx-m .ab{color:#2a2a2a !important}
.rcx-m .lab{color:#3a3a3a !important;border-color:rgba(0,0,0,.25) !important}
.rcx-symt{width:84px;height:84px;margin:0 auto 12px;background:#0b0b0b;border:2px solid var(--gold);border-radius:16px;display:flex;align-items:center;justify-content:center}.rcx-symt .rcx-sym{width:58px;height:58px;margin:0}
.rcx-pair{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:0 auto 26px}.rcx-pair .rcx-box{margin:0;display:flex;flex-direction:column;justify-content:center}
.rcx-cream{background:#F5F1E6 !important}.rcx-cream .rcx-kick{color:#8A6420}.rcx-cream h2{color:#14110C !important}.rcx-cream .rcx-how li{color:#2B261D;text-wrap:balance}.rcx-cream .rcx-how li+li{margin-top:4px}
@media (max-width:760px){.rcx-tiles,.rcx-pair{grid-template-columns:1fr}}

.rcx-strip{position:relative;margin:6px -22px 26px;padding:22px 0 18px;border-top:2px solid var(--gold);border-bottom:2px solid var(--gold);background:rgba(10,9,7,.92);overflow:hidden}
.rcx-track{display:flex;width:max-content}
.rcx-set{display:flex;flex:none}
.rcx-strip .rcx-b{width:86px;flex:none;padding:0 4px}
