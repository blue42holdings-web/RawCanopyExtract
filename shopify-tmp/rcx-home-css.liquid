<style>
body{background:#000}
.rcx{--gold:#D4A24A;--gold2:#E9C079;--cream:#F1ECE1;position:relative;background:#000;color:var(--cream);font-family:'Playfair Display',Georgia,serif;overflow:hidden}
.rcx *{box-sizing:border-box}
.rcx-field{position:absolute;inset:0;z-index:0;background:url("{{ 'rcx-field.svg' | asset_url }}") center top/40px auto repeat;opacity:.22;pointer-events:none}
.rcx-in{position:relative;z-index:1;max-width:980px;margin:0 auto;padding:0 22px 40px}
.rcx-foot{display:flex;justify-content:center;padding:44px 0 24px}.rcx-foot img{width:min(280px,60vw);height:auto}
.rcx-hero{text-align:center;padding:0 0 56px}
.rcx-pk{max-width:760px;margin:26px auto 0;border-bottom:3px solid var(--gold)}.rcx-pk img{display:block;width:100%;height:auto}
.rcx-seal{position:relative;width:min(190px,46vw);aspect-ratio:1/1;display:block;margin:calc(min(190px,46vw) * -0.5) auto 26px;background:#000;border-radius:50%;cursor:pointer}.rcx-seal svg{display:block;width:100%;height:100%}

.rcx h1{font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:clamp(46px,10vw,96px);letter-spacing:.06em;line-height:1;color:var(--gold);margin:0}
.rcx-lines{margin:24px 0 0;font-style:italic;font-size:clamp(20px,3.6vw,30px);line-height:1.45}
