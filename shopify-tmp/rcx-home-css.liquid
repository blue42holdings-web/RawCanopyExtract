.rcx-kick{font-family:'Bebas Neue',sans-serif;letter-spacing:.24em;font-size:17px;color:var(--gold);margin:0 0 14px}
.rcx-box{border:3px solid var(--gold);border-radius:18px;background:rgba(10,9,7,.9);padding:36px 28px;margin:0 auto 26px;text-align:center}
.rcx h2{font-family:'Bebas Neue',sans-serif;font-weight:400;letter-spacing:.05em;font-size:clamp(32px,6.4vw,50px);line-height:1.05;color:var(--cream);margin:0 0 16px;text-wrap:balance}
.rcx-box p{font-size:clamp(17px,2.6vw,21px);line-height:1.6;max-width:44ch;margin:0 auto;text-wrap:balance;color:#DDD5C4}
.rcx-box p+p{margin-top:14px}
.rcx-box p.rcx-tri{max-width:none}.rcx-box p.rcx-tri+p.rcx-tri{margin-top:20px}.rcx-tri span{display:block;white-space:nowrap}
.rcx-three{display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:1fr;gap:14px;margin:0 auto 26px}
